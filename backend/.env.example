# LLM provider: "groq" or "gemini". If unset, uses whichever key below is present (Groq first).
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default Groq model (must support tool calling)
# GROQ_MODEL=openai/gpt-oss-120b

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Supabase (optional — enables auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Frontend URL for CORS (set in production)
FRONTEND_URL=https://your-app.vercel.app
